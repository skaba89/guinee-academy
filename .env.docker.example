# =============================================================================
# Guinée Academy — Variables d'environnement Docker
# =============================================================================
# Copiez ce fichier vers .env.docker et remplissez les valeurs
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=guinee_academy
POSTGRES_USER=guinee_academy
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_PORT=5432

# ─── MinIO (stockage S3) ──────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8chars
MINIO_BUCKET=guinee_academy
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_PORT=6379

# ─── Bootstrap (obligatoire) ──────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
BOOTSTRAP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_DEFAULT_EMAIL=admin@guinee-academy.local
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_min_8_chars

# ─── Backend API ──────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
API_PORT=8000
# Set to True only for local development
DEBUG=False
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL_ASYNC=postgresql+psycopg://guinee_academy:CHANGE_ME_strong_password_here@postgres:5432/guinee_academy
DATABASE_URL_SYNC=postgresql+psycopg://guinee_academy:CHANGE_ME_strong_password_here@postgres:5432/guinee_academy

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# ─── PgAdmin (optionnel, dev uniquement) ──────────────────────────────────────
PGADMIN_EMAIL=admin@guinee-academy.com
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password
PGADMIN_PORT=5050

# ─── Groq AI (optionnel — chatbot IA & audit) ────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096

# ─── Sauvegardes ──────────────────────────────────────────────────────────────
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
