# =============================================================================
# Guinée Academy — Variables d'environnement (template)
# =============================================================================
# Copiez ce fichier vers `.env` et remplissez les valeurs.
# Pour Docker : utilisez `.env.docker` (voir .env.docker.example).
#
# Générer des secrets sécurisés :
#   openssl rand -hex 32   → SECRET_KEY
#   openssl rand -hex 16   → mots de passe DB
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
DEBUG=True
LOG_LEVEL=INFO
VITE_APP_VERSION=1.0.0

# ─── Base de données ──────────────────────────────────────────────────────────
# PostgreSQL (production):  DATABASE_URL=postgresql://user:pass@host:5432/db
# SQLite (local dev):       DATABASE_URL=sqlite:///./guinee_academy.db
# L'application dérive automatiquement une URL async et une URL sync
# si elles ne sont pas définies.  Utilise psycopg v3 (pas de compilation C).
DATABASE_URL=postgresql://guinee_academy:CHANGE_ME@localhost:5432/guinee_academy
DATABASE_URL_ASYNC=postgresql+psycopg://guinee_academy:CHANGE_ME@localhost:5432/guinee_academy
DATABASE_URL_SYNC=postgresql+psycopg://guinee_academy:CHANGE_ME@localhost:5432/guinee_academy
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ─── Sécurité ─────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_DEFAULT_EMAIL=admin@guinee-academy.local
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_min_8_chars

# ─── API Backend ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── MinIO (stockage S3-compatible) ───────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio_password
MINIO_SECURE=false
MINIO_BUCKET=guinee_academy

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ─── Sentry (monitoring erreurs — optionnel) ──────────────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# ─── Email (reset mot de passe, notifications système) ───────────────────────
# Resend (recommandé — gratuit jusqu'à 3 000 emails/mois) : resend.com
RESEND_API_KEY=
# Fallback SMTP (Brevo, Gmail, MailHog en dev...)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Identité expéditeur
FROM_EMAIL=noreply@guinee-academy.com
FROM_NAME=Guinée Academy
# URL frontend utilisée dans les emails (lien reset password, etc.)
FRONTEND_URL=http://localhost:3000

# ─── Stripe Billing ───────────────────────────────────────────────────────────
# Clés disponibles sur dashboard.stripe.com → Developers → API keys
# En dev : utiliser les clés "test" (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs créés dans Stripe Dashboard → Products
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ─── APIs externes (optionnel) ────────────────────────────────────────────────
RESEND_API_KEY=
OPENAI_API_KEY=

# ─── Notifications multi-canaux (configurables par tenant dans les réglages) ──
# WhatsApp Cloud API (Meta) — 1 000 conv/mois gratuit
# Obtenez vos clés sur developers.facebook.com → WhatsApp → Getting Started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OneSignal Push (gratuit jusqu'à 10 000 abonnés)
# Obtenez vos clés sur onesignal.com → Settings → Keys & IDs
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ─── SMS gratuit (2 options — configurables par tenant dans l'interface) ───────
# Option A : Android SMS Gateway (vieux téléphone Android + SIM locale = 100 % gratuit)
# App : https://github.com/capcom5/android-sms-gateway  ou  play.google.com
# Configuré par tenant via Settings → Notifications → SMS
# ANDROID_SMS_GATEWAY_URL=http://192.168.1.42:8080
# ANDROID_SMS_GATEWAY_TOKEN=

# Option B : Africa's Talking (sandbox gratuit, ~0.004 $/SMS en production)
# Couverture : GN, SN, CI, ML, BF, CM, TG, MA, KE, NG, UG, RW, TZ, ZM, ET, GH
# Sandbox : username=sandbox  —  Production : votre vrai username
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=GUINEE_ACADEMY

# Brevo SMTP (300 emails/jour gratuit) — alternatif à RESEND
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=votre@email.com
# SMTP_PASS=votre_cle_brevo

# ─── RGPD & Conformité ────────────────────────────────────────────────────────
VITE_ENABLE_RGPD_LOGS=true
VITE_DATA_RETENTION_YEARS=5

# ─── Alertes & Monitoring ─────────────────────────────────────────────────────
ALERT_EMAIL=admin@guinee-academy.local
ALERT_WEBHOOK=

# ─── Redis (mis en cache, rate limiting) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Groq AI (optionnel — chatbot IA) ───────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096

# ─── Déploiement Render (complété automatiquement par Render Blueprint) ──────
# DATABASE_URL       = lié automatiquement à la base Render
# SECRET_KEY         = généré automatiquement par Render
# BACKEND_CORS_ORIGINS=https://guinee-academy-frontend.onrender.com
# REDIS_URL=redis://guinee-academy-redis:6379/0
# VITE_API_URL=/api-proxy

# ─── Déploiement Netlify (configuré dans le dashboard Netlify) ──────────────
# VITE_API_URL=https://guinee-academy-api.onrender.com
# VITE_ENABLE_PWA=false
# VITE_SENTRY_ENVIRONMENT=production

# ─── Dev proxy (optionnel — par défaut localhost:8000) ──────────────────────
# VITE_DEV_PROXY_TARGET=http://localhost:8000
